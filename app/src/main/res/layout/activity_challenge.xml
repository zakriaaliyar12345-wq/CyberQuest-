<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===================================================== -->
        <!-- TOP BAR -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMissionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MISSION 01 / 07"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#111820"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="05:00"
                android:textColor="#00E676"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- MISSION HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvMissionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PHISHING DETECTIVE"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMissionCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="SOC / PHISHING • EASY"
            android:textColor="#78909C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- ===================================================== -->
        <!-- GAME STATUS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#111820"
            android:orientation="horizontal"
            android:padding="15dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIVES"
                    android:textColor="#607D8B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="♥  ♥  ♥"
                    android:textColor="#FF5252"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:background="#26323A" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WRONG ATTEMPTS"
                    android:textColor="#607D8B"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWrongAttempts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="WRONG: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- OBJECTIVE -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="01 // MISSION OBJECTIVE"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111820"
            android:padding="17dp"
            android:text="Mission description"
            android:textColor="#ECEFF1"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />

        <!-- ===================================================== -->
        <!-- EVIDENCE -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="02 // SECURITY EVIDENCE"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#0D141A"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EVIDENCE // SECURITY CASE"
                android:textColor="#607D8B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#26323A" />

            <TextView
                android:id="@+id/tvEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Security evidence appears here."
                android:textColor="#CFD8DC"
                android:textSize="13sp"
                android:lineSpacingExtra="6dp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- QUESTION -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="03 // INVESTIGATION"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111820"
            android:padding="17dp"
            android:text="Investigation question"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingExtra="5dp" />

        <!-- ===================================================== -->
        <!-- FLAG -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="04 // SUBMIT FLAG"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/etFlag"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="#111820"
            android:hint="CQ{your_answer}"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#546E7A"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="SUBMIT FLAG"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ===================================================== -->
        <!-- HINT -->
        <!-- ===================================================== -->

        <Button
            android:id="@+id/btnHint"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="9dp"
            android:text="💡  REVEAL INVESTIGATION HINT"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1A1710"
            android:padding="16dp"
            android:textColor="#FFCA28"
            android:textSize="13sp"
            android:lineSpacingExtra="5dp"
            android:visibility="gone" />

        <!-- ===================================================== -->
        <!-- FEEDBACK -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/tvFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#111820"
            android:padding="16dp"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <!-- ===================================================== -->
        <!-- XP -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#111820"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MISSION REWARD"
                android:textColor="#607D8B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvXpReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+100 XP"
                android:textColor="#00E676"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="CYBERQUEST // TRAINING ENVIRONMENT"
            android:textColor="#37474F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>