<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // ANALYTICS"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Performance Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze your cybersecurity training performance."
            android:textColor="#90A4AE"
            android:textSize="14sp"
            android:paddingBottom="24dp" />


        <!-- OVERVIEW -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 // OVERVIEW"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />


        <!-- ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="14dp"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL XP"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#00E676"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="14dp"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MISSIONS"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 7"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="14dp"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATTEMPTS"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAttempts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>


            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="14dp"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUCCESS RATE"
                    android:textColor="#90A4AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSuccessRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00E676"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ANALYSIS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="02 // ANALYSIS"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="12dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E141A"
            android:padding="18dp">

            <!-- Wrong -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wrong Answers"
                    android:textColor="#90A4AE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvWrongAnswers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FF5252"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Hints -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hints Used"
                    android:textColor="#90A4AE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvHints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFCA28"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Average Score -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Average Score"
                    android:textColor="#90A4AE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAverageScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Best Grade -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Best Grade"
                    android:textColor="#90A4AE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvBestGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Average Time -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Average Time Remaining"
                    android:textColor="#90A4AE"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAverageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- MISSION PERFORMANCE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="03 // MISSION PERFORMANCE"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="12dp" />


        <LinearLayout
            android:id="@+id/missionPerformanceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <!-- BUTTON -->

        <Button
            android:id="@+id/btnBackDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="RETURN TO DASHBOARD"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#00E676" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // PERFORMANCE ANALYTICS"
            android:textColor="#455A64"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>