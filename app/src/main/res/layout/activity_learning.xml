<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // LEARNING CENTER"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cybersecurity Academy"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learn the concepts behind every CyberQuest mission."
            android:textColor="#78909C"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#101A17">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TRAINING PATH"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Study → Understand → Investigate → Complete Mission"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Each lesson is directly connected to a practical CyberQuest mission."
                android:textColor="#78909C"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:paddingTop="7dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURITY TOPICS"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/learningTopicContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnLearningDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:text="RETURN TO COMMAND CENTER"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E676" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // SECURITY EDUCATION SYSTEM"
            android:textColor="#455A64"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>