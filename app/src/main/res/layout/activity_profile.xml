<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // PLAYER PROFILE"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security Analyst"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CyberQuest Training Identity"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="22dp" />


        <!-- PLAYER IDENTITY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#0E141A">

            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:gravity="center"
                android:text="CQ"
                android:textColor="#00E676"
                android:textSize="25sp"
                android:textStyle="bold"
                android:background="#14231D" />

            <TextView
                android:id="@+id/tvProfileRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROOKIE"
                android:textColor="#90A4AE"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="15dp" />

            <TextView
                android:id="@+id/tvProfileXp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 XP"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="4dp" />

            <ProgressBar
                android:id="@+id/progressProfileRank"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="17dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvProfileRankProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0% TO NEXT RANK • 150 XP"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="8dp" />

        </LinearLayout>


        <!-- TRAINING STATUS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRAINING STATUS"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#101A17">

            <TextView
                android:id="@+id/tvTrainingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TRAINING NOT STARTED"
                android:textColor="#90A4AE"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTrainingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start Mission 1 to begin."
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:paddingTop="8dp" />

        </LinearLayout>


        <!-- CORE STATISTICS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CORE STATISTICS"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="12dp" />


        <!-- STAT ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MISSIONS"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 7"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATTEMPTS"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileAttempts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- STAT ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUCCESS"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileSuccessRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00E676"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST GRADE"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileBestGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFCA28"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- STAT ROW 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WRONG"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileWrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FF5252"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#0E141A">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HINTS"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileHints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFCA28"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingTop="5dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ACHIEVEMENTS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACHIEVEMENT PROGRESS"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="#0E141A">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unlocked Achievements"
                android:textColor="#90A4AE"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProfileAchievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 5"
                android:textColor="#FFCA28"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ACTIONS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROFILE TOOLS"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btnProfileAchievements"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🏆  VIEW ACHIEVEMENTS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#162127" />

        <Button
            android:id="@+id/btnProfileStatistics"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="📊  VIEW ANALYTICS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#162127" />

        <Button
            android:id="@+id/btnProfileDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:text="RETURN TO COMMAND CENTER"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E676" />


        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // PLAYER IDENTIFICATION SYSTEM"
            android:textColor="#455A64"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>