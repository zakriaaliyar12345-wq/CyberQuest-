<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // HISTORY"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MISSION COMPLETION HISTORY"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Review your cybersecurity training performance."
            android:textColor="#78909C"
            android:textSize="14sp" />

        <!-- Total Attempts -->

        <TextView
            android:id="@+id/tvHistoryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#111820"
            android:gravity="center"
            android:padding="16dp"
            android:text="TOTAL ATTEMPTS: 0"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Empty History Message -->

        <TextView
            android:id="@+id/tvEmptyHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#111820"
            android:gravity="center"
            android:padding="30dp"
            android:text="NO MISSION HISTORY YET\n\nComplete a mission to create your first history record."
            android:textColor="#78909C"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:visibility="gone" />

        <!-- History Cards Container -->

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <!-- Clear History -->

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="CLEAR HISTORY"
            android:textStyle="bold" />

        <!-- Dashboard -->

        <Button
            android:id="@+id/btnDashboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="BACK TO DASHBOARD"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp" />

    </LinearLayout>

</ScrollView>