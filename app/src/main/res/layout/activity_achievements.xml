<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // ACHIEVEMENTS"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Badge Collection"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Earn recognition for your cybersecurity skills."
            android:textColor="#78909C"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="22dp" />


        <!-- SUMMARY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:background="#0E141A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNLOCKED ACHIEVEMENTS"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUnlockedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 5"
                android:textColor="#FFCA28"
                android:textSize="32sp"
                android:textStyle="bold"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/tvAchievementProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0% ACHIEVEMENT COMPLETION"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingTop="6dp" />

        </LinearLayout>


        <!-- BADGES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BADGE ARCHIVE"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="28dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/achievementContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <!-- RETURN -->

        <Button
            android:id="@+id/btnAchievementDashboard"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="6dp"
            android:text="RETURN TO COMMAND CENTER"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#00E676" />


        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CYBERQUEST // ACHIEVEMENT SYSTEM"
            android:textColor="#455A64"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="25dp"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>